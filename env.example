# Copia este archivo como ".env" y llena tus datos reales.
# NUNCA compartas el archivo ".env" (ni lo metas en un zip, ni lo subas a git).

OPENAI_API_KEY=pon_aqui_tu_api_key_de_openai

WHATSAPP_TOKEN=pon_aqui_tu_token_de_whatsapp
WHATSAPP_PHONE_ID=pon_aqui_tu_phone_number_id

# Este es un token que TU inventas (cualquier texto/clave que quieras).
# Debes poner el MISMO valor en el panel de Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=inventa-un-token-secreto-aqui

# App Secret de tu app de Meta -- verifica que los webhooks de verdad
# vengan de Meta y no de alguien haciéndose pasar por Meta.
WHATSAPP_APP_SECRET=pon_aqui_tu_app_secret_de_meta

# Ruta al disco persistente de Render (1 GB montado en /var/data). Si lo
# dejas vacío, usa "dalia_bot.db" en el directorio del proyecto (se
# perdería en cada redeploy).
SQLITE_DB_PATH=/var/data/dalia_bot.db

# Opcional. En producción déjalo en "false".
FLASK_DEBUG=false
PORT=5000

# Número personal de Dalia (con lada, sin signos, ej. "5218114905653").
# Recibe la notificación cuando se confirma un anticipo, y queda
# autorizado automáticamente para usar el código de reset 🧸☠️🧸.
DALIA_WHATSAPP_NUMERO=pon_aqui_el_numero_de_dalia

# Opcional. Números adicionales autorizados para usar el código de reset
# 🧸☠️🧸 (por ejemplo, tu propio número de pruebas). Separados por comas,
# mismo formato que DALIA_WHATSAPP_NUMERO. Si lo dejas vacío y tampoco
# configuras DALIA_WHATSAPP_NUMERO, el reset queda deshabilitado.
RESET_NUMEROS_AUTORIZADOS=

# Datos bancarios que el bot comparte para el anticipo, y que también se
# usan para detectar si el modelo intenta mandarlos antes de tiempo (ver
# filtrar_datos_bancarios_si_no_hay_total en app.py). NUNCA los dejes
# escritos directo en el código fuente.
DATOS_BANCARIOS_TARJETA=pon_aqui_el_numero_de_tarjeta
DATOS_BANCARIOS_CLABE=pon_aqui_la_clabe
DATOS_BANCARIOS_BANCO=pon_aqui_el_nombre_del_banco
